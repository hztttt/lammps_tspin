# fcc cobalt: spin-lattice dynamics at constant energy with fix nve/spin/sib
#
# All spins are advanced together with the semi-implicit midpoint method.
# f_integ[4] is the average number of magnetic field evaluations per timestep.
# The conserved quantity is etotal, which includes the Zeeman energy through
# fix_modify energy yes.

units           metal
atom_style      spin
atom_modify     map array
boundary        p p p

lattice         fcc 3.54
region          box block 0.0 4.0 0.0 4.0 0.0 4.0
create_box      1 box
create_atoms    1 box

mass            1 58.93
set             group all spin/atom/random 31 1.72
velocity        all create 200 4928459 mom yes loop geom

pair_style      hybrid/overlay eam/alloy spin/exchange 4.0
pair_coeff      * * eam/alloy Co_PurjaPun_2012.eam.alloy Co
pair_coeff      * * spin/exchange exchange 4.0 0.0446928 0.003496 1.4885

neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20

fix             prec all precession/spin zeeman 1.0 0.0 0.0 1.0
fix_modify      prec energy yes
fix             integ all nve/spin/sib lattice moving

timestep        0.0001

compute         mag all spin
variable        magnorm equal c_mag[4]

thermo          100
thermo_style    custom step time temp v_magnorm pe etotal f_integ[4]
thermo_modify   format float %20.15g

run             1000
