# fcc cobalt: spin-lattice dynamics with a spin bath and fix nve/spin/pc
#
# All spins are advanced together with the predictor-corrector method.  The
# damping, temperature and seed of the spin bath come from fix langevin/spin.
# The lattice is not thermostatted, so its temperature follows the spins.

units           metal
atom_style      spin
atom_modify     map array
boundary        p p p

lattice         fcc 3.54
Lattice spacing in x,y,z = 3.54 3.54 3.54
region          box block 0.0 4.0 0.0 4.0 0.0 4.0
create_box      1 box
Created orthogonal box = (0 0 0) to (14.16 14.16 14.16)
  1 by 1 by 1 MPI processor grid
create_atoms    1 box
Created 256 atoms
  using lattice units in orthogonal box = (0 0 0) to (14.16 14.16 14.16)
  create_atoms CPU = 0.000 seconds

mass            1 58.93
set             group all spin/atom/random 31 1.72
Setting atom values ...
  256 settings made for spin/atom/random
velocity        all create 200 4928459 mom yes loop geom

pair_style      hybrid/overlay eam/alloy spin/exchange 4.0
pair_coeff      * * eam/alloy Co_PurjaPun_2012.eam.alloy Co
pair_coeff      * * spin/exchange exchange 4.0 0.0446928 0.003496 1.4885

neighbor        0.1 bin
neigh_modify    every 10 check yes delay 20

fix             prec all precession/spin zeeman 1.0 0.0 0.0 1.0
fix_modify      prec energy yes
fix             bath all langevin/spin 300.0 0.1 48279
fix             integ all nve/spin/pc lattice moving

timestep        0.0001

compute         mag all spin
variable        magnorm equal c_mag[4]

thermo          100
thermo_style    custom step time temp v_magnorm pe etotal
thermo_modify   format float %20.15g

run             1000
